+// sawblade: FTZ/DAZ on every thread that runs inference (caller + OpenMP team).
+#if defined(__SSE__) || defined(__x86_64__) || defined(_M_X64)
+#include <xmmintrin.h>
+static inline unsigned long sb_fp_get() { return _mm_getcsr(); }
+static inline void sb_fp_set(unsigned long v) { _mm_setcsr((unsigned)v); }
+static inline unsigned long sb_fp_ftz(unsigned long v) { return v | 0x8040u; } // FTZ (bit 15) | DAZ (bit 6)
+#elif defined(__aarch64__)
+static inline unsigned long sb_fp_get()
+{
+    unsigned long v;
+    __asm__ __volatile__("mrs %0, fpcr" : "=r"(v));
+    return v;
+}
+static inline void sb_fp_set(unsigned long v)
+{
+    __asm__ __volatile__("msr fpcr, %0" : : "r"(v));
+}
+static inline unsigned long sb_fp_ftz(unsigned long v) { return v | (1ul << 24); } // FPCR.FZ
+#else
+static inline unsigned long sb_fp_get() { return 0; }
+static inline void sb_fp_set(unsigned long) {}
+static inline unsigned long sb_fp_ftz(unsigned long v) { return v; }
+#endif
+#ifdef _OPENMP
+#include <omp.h>
+#endif
+
+namespace
+{
+// Sets flush-to-zero / denormals-are-zero on the calling thread and on every OpenMP worker
+// of the team that Eigen/OpenBLAS GEMMs will use; restores the previous state on destruction.
+struct FtzScope
+{
+    std::vector<unsigned long> saved;
+    FtzScope()
+    {
+#ifdef _OPENMP
+        const int n = omp_get_max_threads();
+        saved.assign(static_cast<std::size_t>(n), 0);
+#pragma omp parallel num_threads(n)
+        {
+            const int t = omp_get_thread_num();
+            if (t < n)
+            {
+                saved[static_cast<std::size_t>(t)] = sb_fp_get();
+                sb_fp_set(sb_fp_ftz(sb_fp_get()));
+            }
+        }
+#else
+        saved.assign(1, sb_fp_get());
+        sb_fp_set(sb_fp_ftz(sb_fp_get()));
+#endif
+    }
+    ~FtzScope()
+    {
+#ifdef _OPENMP
+        const int n = static_cast<int>(saved.size());
+#pragma omp parallel num_threads(n)
+        {
+            const int t = omp_get_thread_num();
+            if (t < n)
+                sb_fp_set(saved[static_cast<std::size_t>(t)]);
+        }
+#else
+        sb_fp_set(saved[0]);
+#endif
+    }
+};
