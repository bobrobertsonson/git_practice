          "slot": "pedal",
          "modelVersion": 2,
          "params": {
            "level": 1.98,
            "low": 5,
            "high": 10,
            "distortion": 8,
            "tightness": 4,
            "mix": 100,
            "mode": "stock",
            "clip": "silicon",
            "clip2": "follow",
            "lowFreq": 100,
            "lowQ": 0.8,
            "highFreq": 1000,
            "highSpread": 1.5,
            "presenceFreq": 4500,
            "presenceDb": 10,
            "rolloffHz": 9000,
            "gain1Db": 0,
            "gain2Db": 0,
            "bias": 0
          }
        }
      ]
    },
    "b": {
      "enabled": false,
      "blocks": []
    }
  },
  "align": {
    "mode": "off"
  },
  "blend": 0.0,
  "cab": {
    "mode": "shared",
    "ir": {
      "file": "../../../tests/fixtures/ir/impulse.wav"
    }
  }
