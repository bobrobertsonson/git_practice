{
  "schema": "sawblade.preset",
  "version": 1,
  "name": "Custom Wall",
  "notes": "Custom-mode wall of sound: the reissue's second mode with extended low gain and drive. Everything near maximum, low output. Single path, no captures: renders from files in this repo only (the shared cab is the repo identity IR, a stand-in for a real cab). Starting hypotheses, not a tuned tone.",
  "paths": {
    "a": {
      "role": "saw",
      "blocks": [
        {
          "id": "a1",
          "type": "pedal.hm",
          "slot": "pedal",
          "modelVersion": 2,
          "params": {
            "level": 2.82,
            "low": 10,
            "high": 8,
            "distortion": 10,
            "tightness": 2,
            "mix": 100,
            "mode": "custom",
            "clip": "silicon",
            "clip2": "follow",
            "lowFreq": 100,
            "lowQ": 0.8,
            "highFreq": 1000,
            "highSpread": 1.5,
            "presenceFreq": 4800,
            "presenceDb": 8,
            "rolloffHz": 9000,
            "gain1Db": 0,
            "gain2Db": 0,
            "bias": 0
          }
        }
      ]
    },
    "b": {
      "enabled": false,
      "blocks": []
    }
  },
  "align": {
    "mode": "off"
  },
  "blend": 0.0,
  "cab": {
    "mode": "shared",
    "ir": {
      "file": "../../../tests/fixtures/ir/impulse.wav"
    }
  }
}
